-- Helper: The "AirStep" to facilitate the Bind
local function AirStep(char)
	if char.HumanoidRootPart then
		char.HumanoidRootPart.PrimaryPart = char.HumanoidRootPart
		char.HumanoidRootPart.Anchored = true
		Wait()
		char.HumanoidRootPart.Anchored = false -- Unanchor now
	end
}

-- Helper: Wait Functions (Crucial for non-laggy loops)
local function Wait(ms)
	return RunService.Heartbeat:Wait(ms * 0.001)
end

-- Entry Point
local function MainLoop(char)
	char:WaitForChild("HumanoidRootPart")
	
	char.HumanoidRootPart.Name = "EggRoot"
	char.HumanoidRootPart:AttachScriptTarget(Tool, "RootPart")
	
	-- The Real Magic: The "Bind"
	local function Bind(char)
		char.HumanoidRootPart:SetPrimaryPartCFrame(CFrame.new(char.HumanoidRootPart.C, char.HumanoidRootPart.C + Vector3.new(0,2,0)))
		Wait()
		
		-- Check the Egg Tag
		if char.EggTag then
			-- Apply the stolen asset
			char.EggTag.PrimaryPart = char.HumanoidRootPart
		end
	end

	char.HumanoidRootPart:GetPropertyChangedSignal("CFrame"):Connect(function()
		Bind(char)
	end)
}

-- Run
Players.LocalPlayer.CharacterAdded:Connect(MainLoop)
MainLoop(Players.LocalPlayer.Character)
